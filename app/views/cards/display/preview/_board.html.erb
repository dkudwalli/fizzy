<div class="card__board">
  <%= render "cards/display/common/board", card: card  %>
  <% if card.release.present? %>
    <div class="card__release-badge overflow-ellipsis"><%= card.release %></div>
  <% end %>
  <% if card.points.present? %>
    <div class="card__points-badge"><%= card.points %></div>
  <% end %>
</div>
