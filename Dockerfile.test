# syntax=docker/dockerfile:1
# check=error=true

# Test-only image: runs the suite on the Ruby pinned in .ruby-version so the host
# doesn't have to match it. Same packages and env as the OSS/SQLite leg of
# .github/workflows/test.yml. The source tree is bind-mounted at run time rather
# than copied in — see docker-compose.yml.
#
# The production image is Dockerfile; this one is never deployed.

# Keep in sync with .ruby-version and Dockerfile.
ARG RUBY_VERSION=3.4.8
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# The runtime packages CI installs, plus what the native gems need to compile.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl ffmpeg git libsqlite3-0 libssl-dev libvips libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Deliberately no BUNDLE_WITHOUT: the suite needs both the test group (webmock,
# vcr, mocha, minitest-reporters) and the development group it shares with it.
ENV BUNDLE_PATH="/usr/local/bundle" \
    RAILS_ENV="test"

COPY Gemfile Gemfile.lock .ruby-version ./
RUN bundle install

# Run as the host user, so the test run's writes to the bind-mounted storage/,
# log/ and tmp/ don't come back owned by root or by a stranger. docker-compose.yml
# passes the host's real ids; 1000 is only the fallback.
ARG UID=1000
ARG GID=1000
RUN groupadd --system --gid $GID rails && \
    useradd rails --uid $UID --gid $GID --create-home --shell /bin/bash
USER $UID:$GID
